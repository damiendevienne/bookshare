{
  "kind": "collectionType",
  "collectionName": "books",
  "info": {
    "singularName": "book",
    "pluralName": "books",
    "displayName": "Book"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "coverUrl": {
      "type": "string"
    },
    "isbn": {
      "type": "string"
    },
    "catalogSource": {
      "type": "string"
    },
    "catalogId": {
      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "summary": {
      "type": "text",
      "maxLength": 1500
    },
    "ownerComment": {
      "type": "text",
      "maxLength": 500
    },
    "available": {
      "type": "boolean"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "language": {
      "type": "enumeration",
      "enum": [
        "FR", "EN", "GR", "ES", "DE", "IT", "PT", "NL", "AR", "RU", "ZH", "JA"
      ]
    },
    "age": {
      "type": "enumeration",
      "enum": [
        "young_children",
        "children",
        "teenagers",
        "adults"
      ]
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "books"
    },
    "zone": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::zone.zone",
      "inversedBy": "books",
      "required": true
    },
    "loans": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::loan.loan",
      "mappedBy": "book"
    }
  }
}
